OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PORT=3000
DATA_DIR=/var/lib/pastq
MAX_UPLOAD_FILES=80
MAX_UPLOAD_FILE_MB=200
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Comma-separated frontend origins allowed by CORS (required in production).
# Example: https://app.example.com,https://www.example.com
FRONTEND_URL=http://localhost:5173

# Supabase is used only to verify users and store user-owned learning data.
# Never place the service-role key in VITE_ variables or the browser build.
ADMIN_USER_IDS=
SESSION_OWNER_HMAC_SECRET=generate-a-long-random-secret-for-production
AUTH_DISABLED_FOR_LOCAL_DEVELOPMENT=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_UPLOAD_MAX=20

# Optional: a public HTTPS frontend origin or a monitored mailto: contact for Web Push.
# Defaults to the first HTTPS FRONTEND_URL. Keys generate once in DATA_DIR/study-reminders.db.
WEB_PUSH_SUBJECT=
# Optional externally managed VAPID pair. Set both, keep stable, and never expose the private key.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Library storage: questions saved to Hostinger VPS filesystem only.
# This flag is ignored by the production server and must stay false.
LIBRARY_SYNC_SUPABASE=false

# ── Vision pipeline (page transcription → structure → assembly) ──
# One multimodal model does everything. Its capabilities (image input, strict
# JSON schema, tools), output limit and pricing are read live from OpenRouter
# /models at session start; a model lacking any of them pauses the session.
VISION_MODEL=meta/muse-spark-1.3-contributor
# Cap per-call output tokens below the provider maximum (0 = provider maximum).
# VISION_MAX_OUTPUT_TOKENS=0
# Optional reasoning effort passed to the provider (low | medium | high).
# VISION_REASONING_EFFORT=
# Adaptive scheduler: starting, minimum and maximum pages in flight, and how
# many clean calls before concurrency grows again.
# VISION_CONCURRENCY=24
# VISION_MIN_CONCURRENCY=4
# VISION_MAX_CONCURRENCY=128
# VISION_GROW_AFTER=10
# Page image and zoom crop long side (px), and JPEG quality sent to the model.
# VISION_PAGE_IMAGE_SIDE=1600
# VISION_ZOOM_SIDE=1200
# VISION_IMAGE_QUALITY=90
# JPEG quality of stored page rasters.
# VISION_JPEG_QUALITY=94
# Tool turns per page (look, zoom, submit, fix, confirm figures).
# VISION_PAGE_TURNS=24
# Repair turns when an output breaks its contract, then the unit fails visibly.
# VISION_REPAIR_ATTEMPTS=3
# Transient provider retries (rate limit / 5xx / timeout / network).
# VISION_TRANSIENT_RETRIES=8
# Attempts per page before it is marked failed (resume retries it).
# VISION_PAGE_ATTEMPTS=3
# Pages of headings per structure call, and items per adjudication call.
# VISION_STRUCTURE_WINDOW=200
# VISION_ADJUDICATE_BATCH=40
# PDF rasterisation scale (2.5 ≈ 180 DPI), raster worker threads, size limit.
# VISION_PDF_SCALE=2.5
# VISION_RASTER_WORKERS=
# VISION_MAX_PDF_BYTES=209715200
# Pasted text is split into pages of at most this many characters.
# VISION_TEXT_PAGE_CHARS=12000
# Hard safety limits before decoding untrusted images.
# VISION_MAX_INPUT_PIXELS=100000000
# VISION_MAX_INPUT_BYTES=41943040
# VISION_MAX_SIDE=4200
# Session event log cap.
# VISION_MAX_SESSION_EVENTS=5000
# Streaming timeouts: idle gap between chunks, and whole call.
# OPENROUTER_IDLE_TIMEOUT_MS=600000
# OPENROUTER_TIMEOUT_MS=1800000
