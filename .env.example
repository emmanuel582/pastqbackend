OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PORT=3000
DATA_DIR=/var/data/pastq
APP_BASE_URL=https://pastq.app
APP_NAME=PastQ
GEMINI_MODEL_PRIMARY=google/gemini-3.1-pro-preview
GEMINI_MODEL_FALLBACK=google/gemini-3.1-flash-lite
EXTRACTION_RETRIES=4
MAX_UPLOAD_FILES=80
MAX_UPLOAD_FILE_MB=12
PORT=3000
NODE_ENV=development
# Vision provider: groq (test) | mistral (production fallback)
VISION_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Keep these aliases if you already use them locally
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
# Comma-separated frontend origins allowed by CORS (set your Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# Vision cost/quality routing — Groq defaults when VISION_PROVIDER=groq
# VISION_PROVIDER=groq
# VISION_OCR_MODEL=qwen/qwen3.6-27b
# VISION_CHEAP_MODEL=openai/gpt-oss-20b
# VISION_STRONG_MODEL=openai/gpt-oss-120b
# Mistral fallback:
# VISION_PROVIDER=mistral
# VISION_OCR_MODEL=mistral-ocr-latest
# VISION_CHEAP_MODEL=mistral-small-latest
# VISION_STRONG_MODEL=mistral-medium-latest
# VISION_MAX_WIDTH=1600
# VISION_MAX_HEIGHT=2200
# VISION_JPEG_QUALITY=85
# USD_TO_NGN=1400
